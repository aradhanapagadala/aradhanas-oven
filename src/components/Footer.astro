---
import { site } from '../config/site';
import Sticker from './Sticker.astro';

/* chocolate drip edge */
let s = 3;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
let drip = 'M0 0H1440V40';
for (let x = 1440; x > 0; ) {
  const w = 40 + rnd() * 70;
  const len = rnd() > 0.45 ? 50 + rnd() * 90 : 8 + rnd() * 20;
  const nx = Math.max(0, x - w);
  const mid = (x + nx) / 2;
  const r = Math.min(w / 4, 16);
  drip += `C${x - 6} 40 ${mid + r + 4} ${40} ${mid + r} ${40 + len - r}A${r} ${r} 0 0 1 ${mid - r} ${40 + len - r}C${mid - r - 4} 40 ${nx + 6} 40 ${nx} 40`;
  x = nx;
}
drip += 'Z';

/* pumpkins: x, size, hue */
const pumpkins = [
  { x: 4, w: 13, c: '#F2873A', r: -6 },
  { x: 15, w: 9, c: '#FFB36B', r: 8 },
  { x: 26, w: 15, c: '#E9732A', r: -2 },
  { x: 63, w: 10, c: '#F5A05A', r: 10 },
  { x: 74, w: 16, c: '#F2873A', r: -4 },
  { x: 88, w: 10, c: '#FFC27D', r: 6 },
];
---

<footer class="foot">
  <svg class="foot__drip" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
    <path d={drip} fill="var(--choco-800)"></path>
    <path d="M0 18H1440" stroke="rgb(255 255 255 / .12)" stroke-width="6"></path>
  </svg>

  <div class="wrap foot__inner">
    <p class="foot__big display">
      <span class="puffy" data-split>{site.footer.big}</span>
      <span class="puffy foot__big2" data-split>{site.footer.big2}</span>
    </p>
    <div class="foot__row">
      <p class="foot__small hand">{site.footer.small}</p>
      <nav class="foot__links" aria-label="social">
        {site.footer.links.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>)}
        <a href="#home" data-scroll-to="#home" class="foot__top">back to top ↑</a>
      </nav>
    </div>
  </div>

  <div class="patch" aria-hidden="true">
    <svg class="patch__hill" viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path d="M0 90C240 30 420 40 720 80s520 20 720-40V200H0Z" fill="#6F9A4E"></path>
      <path d="M0 120C260 70 480 90 760 110s500 0 680-50V200H0Z" fill="#7FAE5A"></path>
      <path d="M120 112c40-30 80 10 50 30-24 16-56-8-30-24M980 96c40-26 80 12 48 30-22 14-50-8-28-22" fill="none" stroke="#4E7A35" stroke-width="5" stroke-linecap="round"></path>
    </svg>
    {
      pumpkins.map((p, i) => (
        <svg class="pk" style={`left:${p.x}%;width:${p.w}vw;--r:${p.r}deg;--d:${i * 0.4}s`} viewBox="0 0 120 100">
          <path d="M60 22c-2-10 2-18 10-20" fill="none" stroke="#5B3A1E" stroke-width="8" stroke-linecap="round" />
          <path d="M66 18c12-12 30-8 34 2-12 8-26 6-34-2Z" fill="#7FAE5A" stroke="var(--choco-900)" stroke-width="3.5" stroke-linejoin="round" />
          <ellipse cx="34" cy="60" rx="28" ry="34" fill={p.c} stroke="var(--choco-900)" stroke-width="4" />
          <ellipse cx="86" cy="60" rx="28" ry="34" fill={p.c} stroke="var(--choco-900)" stroke-width="4" />
          <ellipse cx="60" cy="60" rx="30" ry="37" fill={p.c} stroke="var(--choco-900)" stroke-width="4" />
          <ellipse cx="48" cy="40" rx="8" ry="4" fill="#fff" opacity=".45" transform="rotate(-30 48 40)" />
          {i % 2 === 0 && (
            <>
              <circle cx="50" cy="60" r="3.6" fill="var(--choco-900)" />
              <circle cx="70" cy="60" r="3.6" fill="var(--choco-900)" />
              <path d="M55 68q5 5 10 0" fill="none" stroke="var(--choco-900)" stroke-width="3" stroke-linecap="round" />
              <ellipse cx="42" cy="68" rx="5" ry="3" fill="var(--pink-500)" opacity=".5" />
              <ellipse cx="78" cy="68" rx="5" ry="3" fill="var(--pink-500)" opacity=".5" />
            </>
          )}
        </svg>
      ))
    }
    <Sticker kind="star" class="patch__star" />
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    margin-top: -60px;
    padding-top: 170px;
    background:
      radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.9) 1px, transparent 1.6px) 0 0 / 110px 110px,
      radial-gradient(circle at 70% 70%, rgb(255 255 255 / 0.6) 1px, transparent 1.6px) 0 0 / 70px 70px,
      linear-gradient(180deg, var(--plum-800), var(--plum-900));
    color: var(--cream);
    overflow: hidden;
  }
  .foot__drip {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 180px;
  }
  .foot__inner {
    position: relative;
    z-index: 2;
    padding-top: clamp(30px, 5vw, 70px);
  }
  .foot__big {
    margin: 0;
    font-size: clamp(3rem, 1.4rem + 7vw, 8.5rem);
    line-height: 0.92;
  }
  .foot__big span {
    display: block;
    --puffy-fill: var(--pink-300);
    --puffy-edge: var(--choco-900);
    --puffy-depth: var(--pink-600);
  }
  .foot__big .foot__big2 {
    --puffy-fill: var(--butter);
    padding-left: 1.2em;
  }
  .foot__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 30px;
    margin-top: clamp(30px, 4vw, 50px);
  }
  .foot__small {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pink-300);
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .foot__links a {
    padding: 8px 16px;
    border: 2.5px solid var(--cream);
    border-radius: 99px;
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: none;
    transition:
      background 0.25s,
      color 0.25s,
      transform 0.3s var(--ease-pop);
  }
  .foot__links a:hover {
    background: var(--cream);
    color: var(--choco-900);
    transform: rotate(-3deg);
  }

  .patch {
    position: relative;
    height: clamp(170px, 20vw, 290px);
    margin-top: clamp(30px, 5vw, 60px);
  }
  .patch__hill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 70%;
  }
  .pk {
    position: absolute;
    bottom: 12%;
    min-width: 70px;
    max-width: 230px;
    overflow: visible;
    rotate: var(--r);
    transform-origin: 50% 100%;
    animation: sway 4s ease-in-out var(--d) infinite alternate;
    filter: drop-shadow(0 8px 0 rgb(0 0 0 / 0.15));
  }
  .pk:nth-of-type(2n) {
    bottom: 22%;
  }
  @keyframes sway {
    to { transform: rotate(5deg) translateY(-4px); }
  }
  .patch :global(.patch__star) {
    position: absolute;
    left: 46%;
    top: 0;
    width: 60px;
    animation: bob 3s ease-in-out infinite;
  }
  @keyframes bob {
    50% { translate: 0 -12px; rotate: 10deg; }
  }
  @media (max-width: 760px) {
    .foot {
      padding-bottom: 80px;
    }
  }
</style>
