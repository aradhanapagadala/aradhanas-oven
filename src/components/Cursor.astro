<!-- The real system pointer stays in charge (styled pink in global.css, zero lag).
     This tag only appears beside it on playful elements: "nom!", "drag me"… -->
<div class="ctag" id="cursor-tag" aria-hidden="true"><span id="cursor-label"></span></div>
<div class="sprinkles" id="sprinkles" aria-hidden="true"></div>

<style>
  .ctag {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 90;
    pointer-events: none;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    html.js .ctag {
      display: block;
    }
  }
  .ctag span {
    display: inline-block;
    padding: 5px 11px 6px;
    border: 2.5px solid var(--choco-900);
    border-radius: 999px 999px 999px 6px;
    background: var(--pink-300);
    color: var(--choco-900);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 3px 0 var(--choco-900);
    transform-origin: 0 100%;
    scale: 0;
    rotate: -8deg;
    transition:
      scale 0.28s var(--ease-pop),
      rotate 0.28s var(--ease-pop);
  }
  .ctag.is-on span {
    scale: 1;
    rotate: -4deg;
  }
  .sprinkles {
    position: fixed;
    inset: 0;
    z-index: 89;
    pointer-events: none;
    overflow: hidden;
  }
  .sprinkles :global(i) {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 4.5px;
    border-radius: 9px;
  }
</style>
