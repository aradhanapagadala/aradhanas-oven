---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { cookieSVG } from '../lib/cookie';
import Oven from './Oven.astro';

const m = site.menu;
const cd = site.order.countdown;
// build-time fallback text (the browser re-formats it in the visitor's own timezone)
const opensLabel = new Date(cd.opensAt)
  .toLocaleString('en-US', { timeZone: 'America/New_York', weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
  .toLowerCase();
const units = [
  { k: 'd', label: 'days' },
  { k: 'h', label: 'hours' },
  { k: 'm', label: 'mins' },
  { k: 's', label: 'secs' },
];
const stamp = Array.from({ length: 3 }, () => `${m.status} ✿ `).join('');
---

<section class="menu" id="menu" aria-labelledby="menu-title">
  <div class="wrap">
    <header class="menu__head">
      <div>
        <p class="kicker">{m.kicker}</p>
        <h2 class="menu__title display puffy" id="menu-title" data-split>{m.heading}</h2>
        <p class="menu__note">{m.note}</p>
      </div>
      <div class="stamp" aria-label={m.status} role="img">
        <svg viewBox="0 0 200 200" class="stamp__ring" aria-hidden="true">
          <defs><path id="stamp-circle" d="M100 100m-72 0a72 72 0 1 1 144 0a72 72 0 1 1-144 0"></path></defs>
          <text><textPath href="#stamp-circle" textLength="450">{stamp}</textPath></text>
        </svg>
        <span class="stamp__core display" aria-hidden="true">soon<br /><small>♥</small></span>
      </div>
    </header>

    <ul class="cards" role="list">
      {
        site.cookies.map((c, i) => (
          <li class="card" style={`--tint:${c.tint}`} data-card>
            <div class="card__plate">
              <div class="card__tags">
                {c.tags.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
              <button class="card__cookie" type="button" aria-label={`take a bite of ${c.name}`} data-bite={c.look === 'brownie' ? 'square' : 'round'} data-cursor="nom!">
                {c.photo ? (
                  <Image src={c.photo} alt="" widths={[300, 600]} sizes="300px" />
                ) : (
                  <Fragment set:html={cookieSVG(c.look, i + 3, { id: `card-${c.id}`, shadow: false })} />
                )}
              </button>
              <span class="card__crumbs" aria-hidden="true" />
            </div>
            <div class="card__body">
              <h3 class="card__name display">{c.name}</h3>
              <p class="card__blurb">{c.blurb}</p>
              <div class="card__foot">
                <span class="card__price hand">{c.price ?? 'price coming soon'}</span>
                <button class="card__fave" type="button" aria-pressed="false" aria-label={`save ${c.name} as a favorite`} data-fave={c.id}>
                  <svg viewBox="0 0 24 22" aria-hidden="true">
                    <path d="M12 21 2.6 11.6A5.6 5.6 0 0 1 12 4.4a5.6 5.6 0 0 1 9.4 7.2Z" />
                  </svg>
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <aside class="order" id="order" aria-labelledby="order-title">
      <div class="order__oven"><Oven id="order-oven" cookie="pumpkinswirl" label="the little oven mascot cheering" /></div>
      <div class="order__text">
        <h3 class="order__title display" id="order-title">{site.order.heading}</h3>
        <p>{site.order.text}</p>

        <div class="cd" data-countdown={cd.opensAt}>
          <p class="cd__label hand">{cd.label}</p>
          <ol class="cd__tiles" role="timer" aria-label={`${cd.label} ${opensLabel}`}>
            {
              units.map((u, i) => (
                <li class="cd__tile" style={`--i:${i}`}>
                  <span class="cd__num display" data-unit={u.k}>
                    <b>00</b>
                  </span>
                  <span class="cd__unit hand">{u.label}</span>
                </li>
              ))
            }
          </ol>
          <p class="cd__open display" hidden>{cd.openNow}</p>
          <p class="cd__when">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="4" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
            <time datetime={cd.opensAt} data-cd-date>{opensLabel}</time>
            <button type="button" class="cd__ics" data-ics data-cursor="yay!">{cd.remind}</button>
          </p>
        </div>

        <div class="order__btns">
          <a class="btn btn--cream" href={site.order.primary.href} target="_blank" rel="noopener" data-cursor="hi!">{site.order.primary.label}</a>
          <a class="btn btn--lav" href={site.order.secondary.href} data-cursor="hi!">{site.order.secondary.label}</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .menu {
    padding: clamp(110px, 12vw, 170px) 0 clamp(70px, 9vw, 120px);
  }
  .menu__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .menu__title {
    margin: 0.15em 0 0.25em;
    font-size: clamp(2.8rem, 1.6rem + 5vw, 6rem);
    --puffy-fill: var(--lav-500);
  }
  .menu__note {
    margin: 0;
    max-width: 44ch;
    color: var(--ink-soft);
  }

  .stamp {
    position: relative;
    flex: none;
    width: clamp(130px, 14vw, 180px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--pink-500);
    border: 3px solid var(--choco-900);
    box-shadow: 0 6px 0 var(--choco-900);
    rotate: 8deg;
  }
  .stamp__ring {
    position: absolute;
    inset: 0;
    animation: stamp-spin 16s linear infinite;
  }
  .stamp__ring text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.06em;
    fill: #fff;
  }
  .stamp__core {
    width: 50%;
    aspect-ratio: 1;
    display: grid;
    place-content: center;
    text-align: center;
    border-radius: 50%;
    background: var(--butter);
    border: 3px solid var(--choco-900);
    font-size: clamp(1rem, 0.8rem + 0.8vw, 1.35rem);
    line-height: 0.9;
  }
  .stamp__core small {
    color: var(--pink-500);
  }
  @keyframes stamp-spin {
    to { rotate: 360deg; }
  }

  /* flex rows so a short last row stays centered, whatever the number of treats */
  .cards {
    --gap: clamp(18px, 2.6vw, 34px);
    --cols: 3;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }
  .card {
    flex: 0 1 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    border: 3px solid var(--choco-900);
    border-radius: 32px;
    background: var(--tint);
    box-shadow: 0 8px 0 var(--choco-900);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .card__plate {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.9;
    padding: 20px;
    border-radius: 29px 29px 0 0;
    overflow: hidden;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.55) 0 14px, transparent 14px 28px),
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--tint) 40%, var(--pink-400)) 0 14px, color-mix(in oklab, var(--tint) 70%, #fff) 14px 28px);
  }
  .card__plate::before {
    content: '';
    position: absolute;
    width: min(76%, 300px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 58%, #f1ebf8 60%, #fff 64%, #ece4f6 100%);
    border: 3px solid var(--choco-900);
    box-shadow: 0 10px 0 rgb(58 23 12 / 0.25);
  }
  .card__cookie {
    position: relative;
    z-index: 1;
    width: min(58%, 240px);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    transition:
      transform 0.5s var(--ease-pop),
      filter 0.3s;
    filter: drop-shadow(0 10px 10px rgb(58 23 12 / 0.25));
  }
  .card__cookie :global(svg),
  .card__cookie :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .card:hover .card__cookie {
    transform: translateY(-8px) rotate(-10deg) scale(1.04);
    filter: drop-shadow(0 22px 16px rgb(58 23 12 / 0.28));
  }
  .card__crumbs {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .card__tags {
    position: absolute;
    z-index: 2;
    left: 14px;
    top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-right: 14px;
  }
  .card__tags span {
    padding: 4px 10px 5px;
    border: 2px solid var(--choco-900);
    border-radius: 99px;
    background: var(--cream);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    line-height: 1;
  }
  .card__tags span:first-child {
    background: var(--pink-500);
    color: #fff;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 6px;
    padding: 18px 22px 18px;
    border-top: 3px solid var(--choco-900);
  }
  .card__name {
    margin: 0;
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.9rem);
  }
  .card__blurb {
    margin: 0;
    flex: 1;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }
  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
  }
  .card__price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pink-600);
  }
  .card__fave {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2.5px solid var(--choco-900);
    border-radius: 50%;
    background: #fff;
    transition: transform 0.3s var(--ease-pop);
  }
  .card__fave svg {
    width: 22px;
    fill: transparent;
    stroke: var(--choco-900);
    stroke-width: 2.4;
    transition: fill 0.2s;
  }
  .card__fave:hover {
    transform: scale(1.12) rotate(-8deg);
  }
  .card__fave[aria-pressed='true'] svg {
    fill: var(--pink-500);
  }

  .order {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(60px, 8vw, 110px);
    padding: clamp(28px, 4vw, 52px) clamp(24px, 5vw, 64px);
    border: 3px solid var(--choco-900);
    border-radius: var(--r-lg);
    background:
      radial-gradient(circle at 2px 2px, rgb(255 255 255 / 0.35) 2px, transparent 2.5px) 0 0 / 22px 22px,
      linear-gradient(120deg, var(--pink-500), var(--pink-400) 60%, var(--lav-400));
    color: #fff;
    box-shadow: 0 10px 0 var(--choco-900);
  }
  .order__oven {
    width: clamp(120px, 14vw, 190px);
    rotate: -6deg;
    animation: bob 3s ease-in-out infinite;
  }
  @keyframes bob {
    50% { translate: 0 -10px; rotate: 3deg; }
  }
  .order__title {
    margin: 0 0 0.25em;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    color: #fff;
    -webkit-text-stroke: 0.12em var(--choco-900);
    paint-order: stroke fill;
  }
  .order__text p {
    margin: 0 0 1.2em;
    max-width: 46ch;
    font-size: 1.1rem;
  }
  .order__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ── countdown: little brownie tiles ── */
  .cd {
    margin: 0 0 1.5em;
  }
  .cd .cd__label {
    margin: 0 0 0.35em;
    max-width: none;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--butter);
    text-shadow: 0 2px 0 var(--pink-600);
  }
  .cd__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(8px, 1.4vw, 14px);
  }
  .cd__tile {
    display: grid;
    justify-items: center;
    gap: 6px;
    rotate: calc((var(--i) - 1.5) * 1.6deg);
  }
  .cd__num {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(64px, 7vw, 92px);
    aspect-ratio: 1 / 0.92;
    overflow: hidden;
    border: 3px solid var(--choco-900);
    border-radius: 18px;
    background:
      radial-gradient(circle at 22% 78%, #ffd166 0 2.2px, transparent 2.6px),
      radial-gradient(circle at 80% 22%, #8fd0ff 0 2.2px, transparent 2.6px),
      radial-gradient(circle at 74% 82%, var(--pink-300) 0 2.2px, transparent 2.6px),
      radial-gradient(120% 120% at 30% 10%, var(--choco-500), var(--choco-700) 55%, var(--choco-800));
    box-shadow:
      inset 0 3px 0 rgb(255 255 255 / 0.16),
      0 5px 0 var(--choco-900);
    color: var(--cream);
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.9rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .cd__num::after {
    /* glossy crust line */
    content: '';
    position: absolute;
    left: 14%;
    top: 9%;
    width: 38%;
    height: 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.22);
  }
  .cd__num :global(b) {
    grid-area: 1 / 1;
    font-weight: inherit;
  }
  .cd__unit {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
  }
  .cd .cd__open {
    margin: 0.2em 0 0.4em;
    max-width: none;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
    color: var(--butter);
    -webkit-text-stroke: 0.1em var(--choco-900);
    paint-order: stroke fill;
  }
  .cd .cd__when {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 1em 0 0;
    font-size: 1rem;
  }
  .cd__when svg {
    width: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .cd__ics {
    padding: 4px 12px 5px;
    border: 2px solid var(--choco-900);
    border-radius: 99px;
    background: var(--butter);
    color: var(--choco-900);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.88rem;
    box-shadow: 0 3px 0 var(--choco-900);
    transition: transform 0.25s var(--ease-pop);
  }
  .cd__ics:hover {
    transform: translateY(-2px) rotate(-2deg);
  }

  @media (max-width: 980px) {
    .cards {
      --cols: 2;
    }
  }
  @media (max-width: 640px) {
    .menu__head {
      flex-direction: column;
      align-items: start;
    }
    .stamp {
      position: absolute;
      right: 16px;
      top: 70px;
      width: 104px;
    }
    .stamp__ring text {
      font-size: 21px;
    }
    .cards {
      --cols: 1;
    }
    .order {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .order__btns,
    .cd__tiles,
    .cd__when {
      justify-content: center;
    }
    .cd__num {
      width: min(72px, calc((100vw - 120px) / 4));
    }
  }
</style>
